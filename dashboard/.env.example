# Провайдер карт: 2gis (по умолчанию) | yandex | google | auto
# При auto выбирается первый готовый в порядке 2ГИС -> Яндекс -> Google.
VITE_MAP_PROVIDER=2gis

# Ключ карт 2ГИС. Без ключа карта не отрисуется -- вместо неё выводится
# поясняющее состояние (молчаливый откат на OSM исключён намеренно).
# Получить: https://console.2gis.ru/  ->  Projects ->  API keys.
# Скопируйте этот файл в .env (в корне репозитория) и впишите ключ.
VITE_TWOGIS_API_KEY=dd2f8518-b305-4440-b459-0febf531ede3
VITE_TWOGIS_LOCALE=ru_RU

# Запасные коммерческие провайдеры. Не нужны, если работает 2ГИС.
VITE_YANDEX_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Центр и зум карты по умолчанию (lat,lon).
VITE_DEFAULT_CENTER=55.7558,37.6173
VITE_DEFAULT_ZOOM=11

# Поток обновлений: /api -- через nginx в compose, пусто при локальной
# разработке. Интервал опроса в миллисекундах.
VITE_API_BASE=/api
VITE_POLL_INTERVAL_MS=3000

# WebSocket-канал вместо опроса. Пусто = используется polling выше.
VITE_WS_URL=

# Только для `npm run dev`: адрес бэкенда для прокси Vite.
VITE_API_PROXY_TARGET=http://localhost:8000
