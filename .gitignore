*.tar
*.zip
*.tar.gz
*.parquet

# Приватные данные хакатона не попадают в публичный репозиторий.
# Исключение -- validate-период: он нужен жюри, чтобы запустить стенд
# одной командой и увидеть работающий дашборд.
dataset/*
!dataset/validate/
!dataset/validate/*.csv

# Прочие csv (train/test/labels, submission.csv) -- локально и в .gitignore
*.csv
!dataset/validate/*.csv

venv/
.venv/
env/
Pipfile.lock
poetry.lock

node_modules/
dist/
.env.local
.env.*.local
npm-debug.log*

# Сборка Sphinx (исходники документации в docs/ коммитятся)
docs/_build/

__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.vscode/
.idea/

*.log
.env
*.egg-info/
